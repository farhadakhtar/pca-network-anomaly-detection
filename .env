# Environment configuration for PCA-Based Network Anomaly Detection

# Set the application environment
# Options: development, testing, production
APP_ENV=development

# Raw data directory override (absolute path)
# RAW_DATA_DIR=<absolute_path>

# Processed data directory override (absolute path)
# PROCESSED_DATA_DIR=<absolute_path>

# Results directory override (absolute path)
# RESULTS_DIR=<absolute_path>

# Set random seed for reproducibility
# Can override default seed (42)
# RANDOM_SEED=<positive_integer>

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO